{
    "$schema": "https://opencode.ai/config.json",
    "model": "deepseek/deepseek-v4-flash-0731",
    "lsp": true,
    "autoupdate": true,
    "mcp": {
        "next-devtools": {
            "command": [
                "npx",
                "-y",
                "next-devtools-mcp@latest"
            ],
            "type": "local",
            "enabled": true
        },
        "shadcn": {
            "command": [
                "npx",
                "-y",
                "shadcn@latest",
                "mcp"
            ],
            "type": "local",
            "enabled": true
        },
        "chrome-devtools": {
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest"
            ],
            "type": "local",
            "enabled": true
        }
    },
    "permission": {
        "edit": "allow",
        "bash": "allow"
    }
}